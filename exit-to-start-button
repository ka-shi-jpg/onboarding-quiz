function renderLesson(text){
  const lines=text.split("\n");let html="",para=[],list=[];
  const fp=()=>{if(para.length){html+="<p>"+inline(para.join(" "))+"</p>";para=[]}};
  const fl=()=>{if(list.length){html+="<ul>"+list.map(li=>"<li>"+inline(li)+"</li>").join("")+"</ul>";list=[]}};
  for(const raw of lines){const line=raw.trim();
    if(line===""){fp();fl();continue}
    const dm=line.match(/^\[\[diagram:([a-z0-9_-]+)\]\]$/i);
    if(dm){fp();fl();html+=(DIAGRAMS[dm[1]]||"");continue}
    if(line.startsWith("## ")){fp();fl();html+="<h3>"+inline(line.slice(3))+"</h3>";continue}
    if(line.startsWith("> ")){fp();fl();html+="<div class='callout'>"+inline(line.slice(2))+"</div>";continue}
    if(line.startsWith("- ")){fp();list.push(line.slice(2));continue}
    fl();para.push(line);}
  fp();fl();return html;
}
function passMark(n){return Math.ceil(n*PASS)}
function shuffleFor(mi,qi,n){
  S.shuffles[mi]=S.shuffles[mi]||{};
  if(!S.shuffles[mi][qi]){const a=[...Array(n).keys()];for(let i=n-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}S.shuffles[mi][qi]=a;saveState()}
  return S.shuffles[mi][qi];
}
function modComplete(mi){const a=S.answers[mi]||{};return Object.keys(a).length===modules[mi].questions.length && modules[mi].questions.length>0}
function modScore(mi){const a=S.answers[mi]||{};let c=0;modules[mi].questions.forEach((q,qi)=>{if(a[qi]===q.answer)c++});return c}
function isUnlocked(mi){return S.admin || mi<=S.unlockedUpTo}

