      <button class="mbtn danger" data-a="del" data-i="${i}">Delete</button>`);
    b.appendChild(r);
  });
  b.querySelectorAll(".mbtn").forEach(btn=>btn.onclick=()=>{const i=+btn.dataset.i,a=btn.dataset.a;
    if(a==="up"&&i>0){[draft[i-1],draft[i]]=[draft[i],draft[i-1]];manageList()}
    if(a==="down"&&i<draft.length-1){[draft[i+1],draft[i]]=[draft[i],draft[i+1]];manageList()}
    if(a==="del"){draft.splice(i,1);manageList();toast("Removed — Cancel to discard, Save to keep")}
