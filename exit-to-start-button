function renderTimeline(){
  const done=modules.filter((m,i)=>modComplete(i)).length;
  let segs="";
  modules.forEach((m,i)=>{
    const dn=modComplete(i), active=i===S.currentIdx, unlocked=isUnlocked(i);
    const cls="seg"+(active?" active":"")+(dn?" done":"")+(S.admin?" clickable":"");
    segs+=`<button class="${cls}" data-i="${i}" style="--seg-accent:${m.color}">
      <span class="fill" style="background:${m.color}"></span>
      <span class="ic" style="color:${dn?m.color:'var(--muted)'}">${dn?'✓':(unlocked?'':'🔒')}</span>
      <span class="num" style="color:${active||dn?m.color:'var(--muted)'}">M${esc(m.num)}</span></button>`;
  });
  return `<div class="tl-meta"><span>TIMELINE · <b>${done}</b> / ${modules.length} DONE</span><span>M${esc(modules[S.currentIdx].num)} · ${esc(modules[S.currentIdx].title)}</span></div>
    <div class="timeline" id="timeline">${segs}</div>`;
}

function renderCourse(){
  const mi=S.currentIdx, m=modules[mi];
  const ans=S.answers[mi]||{}; S.answers[mi]=ans;
  const qhtml = m.questions.map((q,qi)=>{
    const order=shuffleFor(mi,qi,q.options.length);
    const answered=ans[qi]!==undefined;
    const opts=order.map((oi,pos)=>{
      let cls="opt", tag="";
      if(answered){ if(oi===q.answer){cls+=" correct";} else if(oi===ans[qi]){cls+=" wrong";} else {cls+=" dim";}
        if(oi===ans[qi]) tag=`<span class="locktag">🔒 your answer</span>`;
      }
      return `<button class="${cls}" ${answered?"disabled":""} data-q="${qi}" data-o="${oi}">
        <span class="key">${String.fromCharCode(65+pos)}</span><span>${esc(q.options[oi])}</span>${tag}</button>`;
    }).join("");
    return `<div class="q"><div class="qhead"><span class="qn">Q${qi+1}</span><span class="qt">${esc(q.q)}</span></div>
      ${opts}<div class="explain ${answered?"show":""}" id="exp-${mi}-${qi}"><b>WHY</b>${esc(q.explain)}</div></div>`;
  }).join("");

  const total=m.questions.length, count=Object.keys(ans).length, allDone=count===total;
  const lastMod = mi===modules.length-1;
  $("#app").innerHTML=topbar()+renderTimeline()+`
  <div class="card"><div class="pad">
    <div class="eyebrow"><span class="sq"></span>Module ${esc(m.num)} · Lesson</div>
    <h1 class="title">${esc(m.title)}</h1>
