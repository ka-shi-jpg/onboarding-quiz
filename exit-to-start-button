function editModule(i){
  const m=draft[i];$("#modalTitle").textContent="Edit M"+m.num;
  const b=$("#modalBody");b.className="modal-b medit";
  b.innerHTML=`<div class="field"><label>Number</label><input id="e-num" value="${escAttr(m.num)}"/></div>
    <div class="field"><label>Accent color (hex)</label><input id="e-color" value="${escAttr(m.color)}"/></div>
    <div class="field"><label>Title</label><input id="e-title" value="${escAttr(m.title)}"/></div>
    <div class="field"><label>Subtitle</label><input id="e-sub" value="${escAttr(m.subtitle)}"/></div>
    <div class="field"><label>Lesson</label><textarea id="e-lesson">${esc(m.lesson)}</textarea>
      <div class="hint">## heading · - bullet · &gt; note · blank line = paragraph · **bold**</div></div>
    <div class="field"><label>Questions</label><div id="e-qs"></div><button class="mbtn" id="addQ" style="margin-top:6px">+ question</button></div>`;
  const qw=$("#e-qs");
  function drawQs(){qw.innerHTML="";m.questions.forEach((q,qi)=>{
    const d=el("div","qedit",`<div class="qtop"><input value="${escAttr(q.q)}" data-qi="${qi}" data-k="q" placeholder="Question"/><button class="mbtn danger" data-del="${qi}">✕</button></div><div class="opts-${qi}"></div><button class="mbtn" data-addopt="${qi}" style="margin:4px 0 8px">+ option</button><input value="${escAttr(q.explain)}" data-qi="${qi}" data-k="explain" placeholder="Explanation"/>`);
    qw.appendChild(d);const ow=d.querySelector(".opts-"+qi);
    q.options.forEach((opt,oi)=>{const line=el("div","optline",`<input type="radio" name="ans-${qi}" ${q.answer===oi?"checked":""} data-ans="${qi}" data-oi="${oi}" title="correct"/><input type="text" value="${escAttr(opt)}" data-opt="${qi}" data-oi="${oi}" placeholder="Option ${String.fromCharCode(65+oi)}"/><button class="rm" data-rmopt="${qi}" data-oi="${oi}">✕</button>`);ow.appendChild(line)});
  });
  qw.querySelectorAll("input[data-k]").forEach(inp=>inp.oninput=e=>m.questions[+e.target.dataset.qi][e.target.dataset.k]=e.target.value);
  qw.querySelectorAll("input[data-opt]").forEach(inp=>inp.oninput=e=>m.questions[+e.target.dataset.opt].options[+e.target.dataset.oi]=e.target.value);
  qw.querySelectorAll("input[data-ans]").forEach(inp=>inp.onchange=e=>m.questions[+e.target.dataset.ans].answer=+e.target.dataset.oi);
  qw.querySelectorAll("[data-del]").forEach(btn=>btn.onclick=()=>{m.questions.splice(+btn.dataset.del,1);drawQs()});
  qw.querySelectorAll("[data-addopt]").forEach(btn=>btn.onclick=()=>{m.questions[+btn.dataset.addopt].options.push("");drawQs()});
  qw.querySelectorAll("[data-rmopt]").forEach(btn=>btn.onclick=()=>{const q=m.questions[+btn.dataset.rmopt],oi=+btn.dataset.oi;if(q.options.length<=2){toast("Need at least 2 options");return}q.options.splice(oi,1);if(q.answer>=q.options.length)q.answer=0;drawQs()});
  }
  drawQs();
  $("#addQ").onclick=()=>{m.questions.push({q:"",options:["",""],answer:0,explain:""});drawQs()};
  $("#e-num").oninput=e=>m.num=e.target.value; $("#e-color").oninput=e=>m.color=e.target.value;
  $("#e-title").oninput=e=>m.title=e.target.value; $("#e-sub").oninput=e=>m.subtitle=e.target.value;
  $("#e-lesson").oninput=e=>m.lesson=e.target.value;
  $("#modalFooter").innerHTML=`<button class="btn" id="backMg">← Back</button><span class="spacer"></span><button class="btn pri" id="doneEdit">Done</button>`;
  $("#backMg").onclick=manageList; $("#doneEdit").onclick=manageList;
}
function exportJSON(){const data=JSON.stringify(modules,null,2);const bl=new Blob([data],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(bl);a.download="cutting-room-modules.json";a.click();URL.revokeObjectURL(a.href);toast("Exported JSON")}
function importPrompt(){const inp=document.createElement("input");inp.type="file";inp.accept="application/json";inp.onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const p=JSON.parse(r.result);if(!Array.isArray(p))throw 0;modules=normalize(p);saveMod();S.shuffles={};S.currentIdx=0;if(S.unlockedUpTo>=modules.length)S.unlockedUpTo=modules.length-1;saveState();render();toast("Imported "+modules.length+" modules")}catch(err){toast("Import failed — invalid JSON")}};r.readAsText(f)};inp.click()}

let toastT;function toast(m){const t=$("#toast");t.textContent=m;t.classList.add("show");clearTimeout(toastT);toastT=setTimeout(()=>t.classList.remove("show"),2200)}

$("#modalClose").onclick=closeModal;
$("#overlay").addEventListener("click",e=>{if(e.target.id==="overlay")closeModal()});
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeModal()});

if(LOCK_CONTENT){
  document.body.classList.add("locked");
  const inField=e=>e.target&&e.target.closest&&e.target.closest("input,textarea");
  ["copy","cut"].forEach(ev=>document.addEventListener(ev,e=>{ if(!inField(e)) e.preventDefault(); }));
  document.addEventListener("contextmenu",e=>{ if(!inField(e)) e.preventDefault(); });
  document.addEventListener("dragstart",e=>e.preventDefault());
}

// Warn on refresh/close while a test is in progress (browser shows its own generic message).
window.addEventListener("beforeunload",e=>{ if(S && S.screen!=="start"){ e.preventDefault(); e.returnValue=""; } });

render();
