/* ============================ STATE ============================ */
const SK_MOD="cuttingroom2.modules", SK_STATE="cuttingroom2.state", SK_VER="cuttingroom2.ver";
/* Bump CONTENT_VERSION whenever the lesson/question content changes.
   On load, a mismatch clears the old cached copy so the new build always wins. */
const CONTENT_VERSION="2026-08-11-g";
const store={get(k){try{const v=localStorage.getItem(k);return v?JSON.parse(v):null}catch(e){return null}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};

let modules, S;
(function init(){
  if(store.get(SK_VER) !== CONTENT_VERSION){
    modules = normalize(DEFAULT_MODULES);
    store.set(SK_MOD, null); store.set(SK_VER, CONTENT_VERSION);
  } else {
    modules = normalize(store.get(SK_MOD) || DEFAULT_MODULES);
  }
  // Always open on the landing page; progress does not survive a refresh (email is kept for convenience).
  const prevEmail = (store.get(SK_STATE)||{}).email || "";
  S = { screen:"start", email:prevEmail, admin:false, unlockedUpTo:0, currentIdx:0, answers:{}, shuffles:{} };
  store.set(SK_STATE, S);
})();

function normalize(list){
  return list.map((m,i)=>({
    id:m.id||("m"+i+"_"+Math.random().toString(36).slice(2,7)),
    num:m.num||String(i+1), color:m.color||"#A78BFA",
    title:m.title||"Untitled", subtitle:m.subtitle||"", lesson:m.lesson||"",
    questions:(m.questions||[]).map(q=>({q:q.q||"",options:q.options||["",""],answer:typeof q.answer==="number"?q.answer:0,explain:q.explain||""}))
  }));
}
function saveMod(){store.set(SK_MOD,modules)}
function saveState(){store.set(SK_STATE,S)}

