  $("#cancelMg").onclick=closeModal;
  $("#saveMg").onclick=()=>{modules=normalize(draft);saveMod();S.shuffles={};if(S.currentIdx>=modules.length)S.currentIdx=modules.length-1;if(S.unlockedUpTo>=modules.length)S.unlockedUpTo=modules.length-1;saveState();closeModal();render();toast("Modules saved")};
