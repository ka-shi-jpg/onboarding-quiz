    <div class="rule"></div>
    <div class="prose">${renderLesson(m.lesson)}</div>
    <div class="quiz">
      <div class="quiz-h"><span class="lab">Comprehension check</span><span class="cnt" id="qcount">${count} / ${total} answered</span></div>
      <div class="warn-mini">! Your first tap is your answer — it locks in and can't be changed.</div>
      <div class="scorebar"><i id="sfill" style="width:${total?count/total*100:0}%"></i></div>
      ${qhtml}
    </div>
    <div class="btn-row">
      <button class="btn pri" id="nextBtn" ${allDone?"":"disabled"}>${lastMod?"Finish course & see scorecard":"Complete module & unlock next"}</button>
      <div class="subnote">${S.admin?"Admin mode · you can revisit any module":"No going back once completed"}</div>
    </div>
  </div></div>`;
  wireTop();
  if(S.admin){document.querySelectorAll(".seg.clickable").forEach(s=>s.onclick=()=>{S.currentIdx=+s.dataset.i;saveState();render();window.scrollTo({top:0,behavior:'smooth'})})}
  document.querySelectorAll(".opt:not([disabled])").forEach(b=>b.onclick=onAnswer);
  $("#nextBtn").onclick=completeModule;
  window.scrollTo({top:0,behavior:'smooth'});
}

function onAnswer(e){
  const b=e.currentTarget, mi=S.currentIdx, qi=+b.dataset.q, oi=+b.dataset.o;
  const ans=S.answers[mi]; if(ans[qi]!==undefined) return;
  ans[qi]=oi; saveState();
  const q=modules[mi].questions[qi];
  document.querySelectorAll(`.opt[data-q="${qi}"]`).forEach(o=>{
    const j=+o.dataset.o; o.disabled=true;
    if(j===q.answer){o.classList.add("correct")} else if(j===oi){o.classList.add("wrong")} else {o.classList.add("dim")}
    if(j===oi){o.insertAdjacentHTML("beforeend",'<span class="locktag">🔒 your answer</span>')}
  });
  $("#exp-"+mi+"-"+qi).classList.add("show");
  const total=modules[mi].questions.length, count=Object.keys(ans).length;
  $("#qcount").textContent=count+" / "+total+" answered";
  $("#sfill").style.width=(count/total*100)+"%";
  if(count===total) $("#nextBtn").disabled=false;
}

function completeModule(){
  const mi=S.currentIdx;
  if(!modComplete(mi)) return;
  if(mi>=S.unlockedUpTo) S.unlockedUpTo=Math.min(mi+1,modules.length-1);
  if(mi<modules.length-1){ if(!S.admin) S.currentIdx=mi+1; }
  else { S.screen="done"; }
  saveState(); render();
}

function renderScore(){
  const rows=modules.map((m,i)=>{
    const sc=modScore(i), tot=m.questions.length, pct=tot?Math.round(sc/tot*100):0;
    return `<div class="sc-row">
